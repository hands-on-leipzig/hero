APP_NAME=HERO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

APP_LOCALE=de
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# SQLite under storage/ (kept across deploys). Leave DB_DATABASE unset for storage/app/hero.sqlite.
DB_CONNECTION=sqlite

# Stateless JSON API (Bearer tokens) — no sessions or queues needed.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Keycloak (tokens from the HERO SPA, client "hero")
KEYCLOAK_ISSUER=https://sso.hands-on-technology.org/realms/master
KEYCLOAK_CLIENT_ID=hero

# FLOW public API for volunteer openings and inquiries
# Test: https://dev.flow.hands-on-technology.org/api
FLOW_API_URL=https://flow.hands-on-technology.org/api

# HERO's own Entra app for SharePoint (application permission Sites.Read.All)
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
