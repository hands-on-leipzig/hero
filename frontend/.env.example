# Keycloak (see README)
# VITE_KEYCLOAK_URL=https://sso.hands-on-technology.org
# VITE_KEYCLOAK_REALM=master
# VITE_KEYCLOAK_CLIENT_ID=hero

# HERO backend. The SPA calls /api on its own origin (Laravel serves both in production).
# Local: Vite proxies /api to the Laravel dev server.
#   VITE_BACKEND_PROXY_TARGET=http://localhost:8001
# Only if the API lives elsewhere:
#   VITE_API_URL=https://hero.hands-on-technology.org/api
#
# DRAHT public venues (same catalog as JOIN).
#   VITE_DRAHT_API_URL=https://dev.draht.hands-on-technology.org/custom/handson/api_proxy.php
#   VITE_VENUES_API_URL=
