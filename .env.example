# Keycloak (see README)
# VITE_KEYCLOAK_URL=https://sso.hands-on-technology.org
# VITE_KEYCLOAK_REALM=master
# VITE_KEYCLOAK_CLIENT_ID=hero

# FLOW API for volunteer openings.
# Local + Vite: relative /flow-api, proxied to Laravel (see vite.config.js).
#   VITE_FLOW_API_URL=/flow-api
#   VITE_FLOW_PROXY_TARGET=http://localhost:8000
# Production example:
#   VITE_FLOW_API_URL=https://flow.hands-on-technology.org/api
#
# DRAHT public venues (same catalog as JOIN).
#   VITE_DRAHT_API_URL=https://dev.draht.hands-on-technology.org/custom/handson/api_proxy.php
#   VITE_VENUES_API_URL=
